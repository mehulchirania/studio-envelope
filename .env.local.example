# Copy this file to .env.local and fill in the values (see README.md "Setting up the backend").
# .env.local is gitignored — never commit real values.

# Firebase (Project settings -> General -> Your apps -> Web app -> SDK setup and config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must match the email(s) in firestore.rules' isAdmin() allowlist.
ADMIN_EMAILS=

# Vercel Blob (Storage -> Create Database -> Blob -> store's ".env.local" tab)
BLOB_READ_WRITE_TOKEN=
