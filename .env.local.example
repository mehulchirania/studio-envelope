# Copy this file to .env.local and fill in the values (see README.md "Setting up the backend").
# .env.local is gitignored — never commit real values.

# Firebase (Project settings -> General -> Your apps -> Web app -> SDK setup and config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The server's private Firebase email/password account (README step 4). The email must match firestore.rules.
FIREBASE_ADMIN_EMAIL=cms@studio-envelope.invalid
FIREBASE_ADMIN_PASSWORD=

# Signs the admin login cookie. Required in production; use 32+ random characters.
ADMIN_SESSION_SECRET=

# Optional: override the default admin logins (see README "Admin panel"), e.g. admin:passphrase,prachi:passphrase
# ADMIN_USERS=

# Vercel Blob (Storage -> Create Database -> Blob -> store's ".env.local" tab)
BLOB_READ_WRITE_TOKEN=

# Local testing only: use the Firebase emulators instead of the real project.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Contact form email (Resend, https://resend.com). Without RESEND_API_KEY enquiries are only saved to the admin inbox.
# CONTACT_FROM_EMAIL must be on a domain verified in Resend, e.g. "Studio Envelope <enquiries@studioenvelope.com>".
RESEND_API_KEY=
# CONTACT_TO_EMAIL=hello@studioenvelope.com
# CONTACT_FROM_EMAIL=
