rules_version = '2';

// Who may write: nobody in a browser. The admin panel's logins ("admin",
// "prachi") are checked by the Next.js server, which then signs in to Firebase
// as ONE private email/password account (credentials only in the server's
// FIREBASE_ADMIN_EMAIL / FIREBASE_ADMIN_PASSWORD env vars) and performs the
// reads and writes. That account is the only one these rules trust.
// If you change the account's email, change it here too and redeploy:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Note: the admin account is trusted by email. Once its uid is known, prefer
    // matching request.auth.uid instead (an email can be reassigned; a uid cannot).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'cms@studio-envelope.invalid';
    }

    // projects: publicly readable when published; the server account can read/write everything.
    // The public read condition intentionally matches the public query shape
    // (where("published", "==", true)) so Firestore can validate `list`
    // requests against the rule without per-document reads.
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // videos: same pattern as projects. The public query is where("published", "==", true).
    match /videos/{videoId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // messages: enquiries are validated and saved by the Next.js server
    // (/api/contact), which enforces consent, age declaration, size limits and
    // rate limits. Browsers cannot read or write them at all; only the server
    // account can (inbox, mark read, delete, and the retention purge).
    match /messages/{messageId} {
      allow read, write: if isAdmin();
    }

    // adminUsers: hashed passwords changed from the admin panel. Server account only.
    match /adminUsers/{username} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
