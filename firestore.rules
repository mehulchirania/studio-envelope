rules_version = '2';

// Who may write: nobody in a browser. The admin panel's logins ("admin",
// "prachi") are checked by the Next.js server, which then signs in to Firebase
// as ONE private email/password account (credentials only in the server's
// FIREBASE_ADMIN_EMAIL / FIREBASE_ADMIN_PASSWORD env vars) and performs the
// reads and writes. That account is the only one these rules trust.
// If you change the account's email, change it here too and redeploy:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'cms@studio-envelope.invalid';
    }

    function isValidMessage() {
      let incoming = request.resource.data;
      let allowedKeys = ['name', 'email', 'message', 'phone', 'projectType', 'city', 'area', 'budget', 'timeline', 'hearAbout', 'read', 'createdAt'];
      let requiredKeys = ['name', 'email', 'message', 'read', 'createdAt'];
      return incoming.keys().hasOnly(allowedKeys)
        && incoming.keys().hasAll(requiredKeys)
        && incoming.name is string && incoming.name.size() > 0 && incoming.name.size() <= 100
        && incoming.email is string && incoming.email.size() > 0 && incoming.email.size() <= 200
        && incoming.message is string && incoming.message.size() > 0 && incoming.message.size() <= 3000
        && (!('phone' in incoming) || (incoming.phone is string && incoming.phone.size() <= 30))
        && (!('projectType' in incoming) || (incoming.projectType is string && incoming.projectType.size() <= 60))
        && (!('city' in incoming) || (incoming.city is string && incoming.city.size() <= 100))
        && (!('area' in incoming) || (incoming.area is string && incoming.area.size() <= 40))
        && (!('budget' in incoming) || (incoming.budget is string && incoming.budget.size() <= 60))
        && (!('timeline' in incoming) || (incoming.timeline is string && incoming.timeline.size() <= 60))
        && (!('hearAbout' in incoming) || (incoming.hearAbout is string && incoming.hearAbout.size() <= 60))
        && incoming.read == false
        && incoming.createdAt == request.time;
    }

    // projects: publicly readable when published; the server account can read/write everything.
    // The public read condition intentionally matches the public query shape
    // (where("published", "==", true)) so Firestore can validate `list`
    // requests against the rule without per-document reads.
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // messages: anyone can submit a well-formed, unread message; only the
    // server account can read the inbox or mark/delete messages.
    match /messages/{messageId} {
      allow create: if isValidMessage();
      allow read, update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
